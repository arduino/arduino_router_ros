<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arduino_router_ros</name>
  <version>0.0.1</version>
  <description>ROS2 proxy bridge for Arduino Q boards</description>
  <maintainer email="l.rossi@arduino.cc">arduino</maintainer>
  <license>MPL-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

  <depend>rclpy</depend>
  <depend>builtin_interfaces</depend>

  <!-- Executable dependencies -->
  <exec_depend>python3-msgpack</exec_depend>
  <exec_depend>python3-watchdog</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

</package>
